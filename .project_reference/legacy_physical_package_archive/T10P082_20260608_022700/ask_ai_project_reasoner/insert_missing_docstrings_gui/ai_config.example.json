{
  "base_url": "http://localhost:11434/v1",
  "model": "qwen2.5-coder:7b",
  "timeout_seconds": 30.0,
  "max_tokens": 512,
  "temperature": 0.0,
  "fallback_to_heuristic": false,
  "workers": 1,
  "cache_enabled": true,
