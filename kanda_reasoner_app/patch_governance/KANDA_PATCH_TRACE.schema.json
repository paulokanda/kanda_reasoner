{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KANDA Patch Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "feature_id",
    "patch_name",
    "router_bridge_used",
    "prompt_paths_loaded",
    "source_files_inspected",
    "source_baselines",
    "target_box",
    "forbidden_boxes",
    "allowed_write_paths",
    "forbidden_write_paths",
    "files_changed",
    "validation_commands",
    "validation_markers",
    "delivery_manifest_sha256",
    "install_manifest_sha256",
    "freeze_hint_sha256"
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonEmptyStringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "operation",
        "baseline_sha256",
        "installed_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "operation": {
          "enum": [
            "add",
            "replace",
            "delete"
          ]
        },
        "baseline_sha256": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{64}$"
        },
        "installed_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "kind": {
      "const": "kanda_patch_trace"
    },
    "feature_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "patch_name": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "router_bridge_used": {
      "const": "pre_output_contract_gates"
    },
    "prompt_paths_loaded": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "source_files_inspected": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "source_baselines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceBaseline"
      },
      "minItems": 1
    },
    "target_box": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "forbidden_boxes": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "allowed_write_paths": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "forbidden_write_paths": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "files_changed": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "validation_commands": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "validation_markers": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "delivery_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "install_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "freeze_hint_sha256": {
      "$ref": "#/$defs/sha256"
    }
  }
}
