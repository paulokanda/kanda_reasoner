{
  "schema_name": "harness_run_record_schema",
  "schema_version": "3.41-adviser-schema-family-design",
  "feature_id": "routing_signal_scorer_v3_adviser_schema_family_design_v1",
  "design_status": "design_only_json_contract_no_validator_no_candidate_no_harness_no_runtime_behavior_change",
  "authority_policy": "advisory_only_evidence_not_router_authority",
  "forbidden_runtime_behaviors": [
    "runtime_router_integration",
    "prompt_auto_loading",
    "router_authority_change",
    "automatic_freeze_write",
    "autonomous_decision_recording",
    "source_scanning",
    "artifact_generation",
    "artifact_reading",
    "artifact_writing",
    "embeddings",
    "vector_indexes",
    "provider_calls",
    "dependency_installation",
    "network_calls"
  ],
  "required_fields": [
    "schema_version",
    "run_id",
    "timestamp",
    "candidate_id",
    "candidate_version",
    "candidate_code_hash",
    "gold_set_version",
    "gold_manifest_hash",
    "cases_run",
    "critical_failures",
    "status"
  ],
  "enums": {
    "status": [
      "draft",
      "completed",
      "failed",
      "blocked",
      "eligible_for_review"
    ]
  },
  "safety_rules": [
    "run records are provenance for evaluation only",
    "run records do not authorize routing behavior"
  ]
}
