    "artifact_writing",
    "embeddings",
    "vector_indexes",
    "provider_calls",
    "dependency_installation",
    "network_calls"
  ],
  "required_fields": [
    "schema_version",
    "candidate_id",
    "candidate_version",
    "code_hash",
    "schema_version_used",
    "gold_set_version",
    "run_id",
    "critical_failures",
    "high_failures",
    "status",
    "created_at"
  ],
  "enums": {
    "status": [
      "draft",
      "tested",
      "blocked",
      "eligible_for_review",
      "frozen",
      "deprecated"
    ]
  },
  "safety_rules": [
    "candidate registry is provenance only",
    "critical failures block eligible_for_review",
    "candidate registry does not create runtime authority"
  ]
}
